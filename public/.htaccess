# Apache (VPS) : page 404 « Pas de signal », compression et cache des fichiers
ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  # fichiers versionnés par Astro (leur nom change à chaque modif)
  <FilesMatch "\.(js|css|webp|avif|png|jpg|svg|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression gzip des fichiers texte (HTML, CSS, JS, SVG, XML) : ~3 fois moins lourds à télécharger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
