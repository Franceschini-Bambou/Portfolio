---
// Gabarit commun à toutes les pages.
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TvLayer from '../components/TvLayer.astro';
import BootScreen from '../components/BootScreen.astro';
import { langOf, langs, switchLang, ogLocale, useT } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** nom de l'écran (utile pour les lecteurs d'écran) */
  label?: string;
  /** page d'accueil : titre complet du site */
  home?: boolean;
  /** pas de version dans l'autre langue (page 404) */
  noAlternate?: boolean;
}
// la langue se lit dans l'adresse : /en/... = anglais
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const { title, description = t('meta.description'), label, home = false, noAlternate = false } = Astro.props;
const fullTitle = home ? t('meta.homeTitle') : `${title} — Canal BF · Bambou Franceschini`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// la même page dans les deux langues (pour Google : balises hreflang)
const alternates = noAlternate ? [] : langs.map((l) => ({ lang: l, href: new URL(switchLang(Astro.url.pathname, l), Astro.site) }));
---
<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1D0B0C" />
    <!-- nom unique : évite que le navigateur confonde avec l'icône d'un autre site en local -->
    <link rel="icon" type="image/svg+xml" href="/favicon-canal-bf.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <ClientRouter />
  </head>
  <body>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[1000] focus:bg-cream focus:px-4 focus:py-2 focus:text-ink">{t('skip')}</a>
    <div class="relative min-h-screen">
      <Header />
      <main id="contenu" data-screen-label={label}>
        <slot />
      </main>
      <Footer />
    </div>
    <BootScreen />
    <TvLayer />
    <script src="../scripts/tv.ts"></script>
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/boot.ts"></script>
  </body>
</html>
