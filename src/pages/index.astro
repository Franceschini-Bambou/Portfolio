---
// CH 01 — ACCUEIL
import Base from '../layouts/Base.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import ChannelNumber from '../components/ChannelNumber.astro';
import Window from '../components/Window.astro';
import Btn from '../components/Btn.astro';
import Marquee from '../components/Marquee.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ProgramGuide from '../components/ProgramGuide.astro';
import Img from '../components/Img.astro';
import { getContent } from '../lib/data';
import { mediaUrl } from '../lib/media';

const { site, projects: allProjects } = await getContent();
// L'accueil n'affiche que les 3 premiers projets (ordre du champ « sort » dans PocketBase)
const projects = allProjects.slice(0, 3);
const portrait = site.portrait;
const portraitUrl = await mediaUrl(portrait, 900);
---
<Base title="Accueil" label="CH 01 Accueil">
  <!-- HÉROS : émission en direct -->
  <section class="relative overflow-hidden bg-ink">
    <HeroBackdrop glow bands={[{ top: '34%', h: 22 }, { top: '61%', h: 8, delay: '2.4s', reverse: true, pos: '30% 70%' }]} />

    <div class="relative mx-auto flex max-w-[1440px] flex-col gap-5 px-4 pt-6 pb-10 sm:px-6 lg:gap-[22px] lg:px-14 lg:pt-7">
      <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-0.5 font-vt text-[20px] leading-[1.1] text-cream [text-shadow:2px_2px_0_#000] sm:text-[28px]">
          <span class="flex items-center gap-2.5"><span class="animate-blink text-magenta" aria-hidden="true">●</span>EN DIRECT — CANAL BF</span>
          <span class="text-rose">Portfolio — 2026</span>
        </div>
        <ChannelNumber n={1} />
      </div>

      <h1 class="m-0 animate-jit font-display leading-[.86] tracking-[-2px]">
        <span class="block text-giant text-cream chroma-3 sm:chroma-6">Bambou</span>
        <span class="mt-2 block text-sub-name text-rose chroma-2 sm:chroma-4">Franceschini</span>
      </h1>

      <div class="mt-1.5 grid grid-cols-1 items-stretch gap-6 md:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)_minmax(0,1fr)] lg:gap-9">
        <div class="flex flex-col justify-center gap-3 md:col-span-2 lg:col-span-1">
          <p class="m-0 font-display text-h3-lg leading-none text-cream chroma-3">Design / Com</p>
          <p class="m-0 text-lead font-medium leading-tight text-cream">J'aime rendre les idées réalité</p>
        </div>

        <Window title="citation.txt" class="shadow-[8px_8px_0_var(--color-bordeaux)]">
          <figure class="m-0 flex flex-col gap-2.5 px-5 py-5 sm:px-6">
            <blockquote class="m-0">
              <p class="m-0 leading-[1.45]">«&nbsp;Il y a trois réactions possibles à tout design : oui, non, et <strong class="font-display font-normal text-bordeaux chroma-2">WAHOU&nbsp;!</strong> La troisième est celle que je vise.&nbsp;»</p>
            </blockquote>
            <figcaption class="font-vt text-[24px] text-bordeaux">— Milton Glaser</figcaption>
          </figure>
        </Window>

        <Window title="stage.exe" bg="var(--color-rose)" class="shadow-[8px_8px_0_var(--color-bordeaux)]">
          <div class="flex flex-1 flex-col justify-between gap-4 px-5 py-5 sm:px-6">
            <p class="m-0 leading-[1.4] font-medium">À la recherche d'un stage {site.stage}</p>
            <Btn href="/contact/" variant="bordeaux" prefix="▶" class="self-start">Me contacter</Btn>
          </div>
        </Window>
      </div>

      <!-- Ce soir sur Canal BF : les projets dès le haut de page -->
      <nav class="mt-2.5 grid grid-cols-1 border-[3px] border-cream bg-ink md:grid-cols-3 xl:grid-cols-[200px_repeat(3,minmax(0,1fr))]" aria-label="Projets à l'antenne">
        <div class="flex items-baseline justify-between gap-3 bg-cream px-4 py-3 leading-none text-ink md:col-span-3 xl:col-span-1 xl:flex-col xl:justify-center xl:gap-0 xl:px-[18px] xl:py-3.5">
          <span class="font-vt text-[22px] text-bordeaux">CE SOIR SUR</span>
          <span class="font-display text-[24px] xl:text-[26px]">Canal BF</span>
        </div>
        {projects.map((p, i) => {
          const Tag = p.hasPage ? 'a' : 'div';
          return (
            <Tag href={p.hasPage ? `/projets/${p.slug}/` : undefined}
              class:list={['group flex items-center gap-4 border-t-[3px] border-cream px-4 py-3.5 text-cream no-underline transition-colors md:flex-col md:items-start md:gap-2 md:px-5 xl:flex-row xl:items-center xl:gap-4 xl:border-t-0 xl:border-l-[3px]', i > 0 && 'md:border-l-[3px]', p.hasPage ? 'hover:bg-bordeaux' : '']}>
              <span class="font-vt text-[30px] leading-none xl:text-[34px]" style={`color:${p.color}`}>{p.time}</span>
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="font-display text-[20px] leading-[1.1] group-hover:chroma-3 xl:text-[22px]">{p.title}</span>
                <span class="font-vt text-[21px] leading-none text-rose">{p.genre} · {p.year}</span>
              </span>
            </Tag>
          );
        })}
      </nav>
    </div>
  </section>

  <Marquee />

  <!-- Qui suis-je ? -->
  <section class="bg-cream text-ink">
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 items-center gap-14 px-4 py-20 sm:px-6 md:py-24 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-20 lg:px-14 lg:py-[120px]">
      <div class="flex flex-col gap-6 lg:gap-8">
        <Eyebrow>(01) — Présentation</Eyebrow>
        <h2 class="m-0 font-display text-h2-xl leading-[.9] text-bordeaux chroma-3 sm:chroma-5">Qui<br /><span class="whitespace-nowrap">suis-je&nbsp;?</span></h2>
        <p class="m-0 max-w-[620px] text-lead-sm leading-[1.4] font-medium">Je suis Bambou, étudiante en 2e année de BUT MMI à Montbéliard, spécialisée en création numérique.</p>
        <p class="m-0 max-w-[600px] leading-[1.6]">Passionnée par la création en général — design graphique, vidéo, art et même la danse — j'aspire à faire marcher mon imagination au service d'idées claires.</p>
        <div class="flex gap-4">
          <Btn href="/a-propos/" variant="cream" prefix="CH 03">En savoir plus</Btn>
        </div>
      </div>

      <Window title="portrait.jpg" bg="var(--color-rose)" class="rotate-[1.2deg] shadow-[8px_8px_0_var(--color-bordeaux)] sm:shadow-[12px_12px_0_var(--color-bordeaux)]">
        <div class="relative m-3 h-[clamp(300px,80vw,470px)] overflow-hidden border-[3px] border-ink bg-ink sm:m-3.5 lg:h-[470px]">
          {portrait && <Img src={portrait} alt="Portrait de Bambou Franceschini" width={1000} loading="lazy" class="absolute inset-0 size-full object-cover contrast-[1.1] grayscale" />}
          <div class="absolute inset-x-0 top-[25%] h-4 animate-[band_2.8s_steps(1)_infinite] bg-cover bg-center opacity-70 mix-blend-screen grayscale" style={`background-image:url(${portraitUrl})`} aria-hidden="true"></div>
          <div class="absolute inset-x-0 top-[70%] h-1.5 animate-[band_3.6s_steps(1)_infinite] bg-cyan opacity-60 mix-blend-multiply" aria-hidden="true"></div>
          <div class="scanlines pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <div class="vignette pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <span class="absolute top-3.5 left-4 flex items-center gap-2 font-vt text-[28px] text-cream [text-shadow:2px_2px_0_#000]" aria-hidden="true"><span class="animate-blink text-magenta">●</span>REC</span>
          <span class="absolute right-4 bottom-3 font-vt text-[28px] text-cream [text-shadow:2px_2px_0_#000]" data-tc aria-hidden="true">SP 00:00:26</span>
        </div>
      </Window>
    </div>
  </section>

  <!-- Programme TV -->
  <section id="programme" class="border-t-[3px] border-ink bg-rose text-ink">
    <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-4 pt-20 pb-24 sm:px-6 lg:gap-12 lg:px-14 lg:pt-[110px] lg:pb-[120px]">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between md:gap-10">
        <div class="flex flex-col gap-4 lg:gap-5">
          <Eyebrow>(02) — Programme TV</Eyebrow>
          <h2 class="m-0 font-display text-h2 leading-[.9] text-bordeaux chroma-3 sm:chroma-5">Ce soir<br />sur Canal BF</h2>
        </div>
        <Btn href="/projets/" variant="ink" prefix="CH 02" class="shrink-0">Tous les projets</Btn>
      </div>
      <ProgramGuide projects={projects} />
    </div>
  </section>
</Base>
