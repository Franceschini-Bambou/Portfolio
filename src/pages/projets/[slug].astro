---
// Page projet (FR) : une page par projet publié dans PocketBase.
// Le contenu est dans src/views/Project.astro
// (après un nouveau projet dans PocketBase, relance `npm run dev` si la page fait 404)
import Project from '../../views/Project.astro';
import { getContent } from '../../lib/data';

export async function getStaticPaths() {
  const { projects } = await getContent('fr');
  return projects.filter((p) => p.hasPage).map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
---
<Project project={Astro.props.project} lang="fr" />
