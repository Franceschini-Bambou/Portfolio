---
// Pied de page : mire de couleurs + « Fin de transmission »
import Btn from './Btn.astro';
import { channelsFor, pad2 } from '../lib/channels';
import { getContent } from '../lib/data';
import { langOf, routes, switchLang, useT } from '../i18n/ui';
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const channels = channelsFor(lang);
const { site } = await getContent(lang);
const other = lang === 'fr' ? 'en' : 'fr';
const bars = ['#D9D4CC', '#E2B84A', '#2EE6D6', '#8CBF6F', '#FF2E88', '#6F080C', '#4F86A6'];
const sub = ['#4F86A6', '#1D0B0C', '#FF2E88', '#1D0B0C', '#2EE6D6', '#1D0B0C', '#D9D4CC'];
---
<footer class="bg-ink text-cream">
  <div class="grid h-[clamp(56px,10.4vw,150px)] grid-cols-7" aria-hidden="true">
    {bars.map((c) => <span style={`background:${c}`}></span>)}
  </div>
  <div class="grid h-[clamp(10px,1.8vw,26px)] grid-cols-7" aria-hidden="true">
    {sub.map((c) => <span style={`background:${c}`}></span>)}
  </div>

  <div class="mx-auto flex max-w-[1440px] flex-col gap-10 px-4 pt-14 pb-24 sm:px-6 lg:gap-12 lg:px-14 lg:pt-[72px] lg:pb-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-10">
      <p class="m-0 font-display text-h2-sm leading-[.9] text-cream chroma-3 lg:chroma-5" set:html={t('footer.end')} />
      <div class="flex max-w-[440px] flex-col items-start gap-[18px] md:items-end md:text-right">
        <a href={routes.home[lang]} aria-label={t('footer.homeAria')}>
          <img src="/logo-bf.webp" alt="" width="256" height="96" loading="lazy" class="block h-[72px] w-auto lg:h-24" style="filter:drop-shadow(-3px 0 0 rgba(46,230,214,.7)) drop-shadow(3px 0 0 rgba(255,46,136,.7))" />
        </a>
        <p class="m-0 leading-normal">{t('footer.tagline')} {site.stage}.</p>
        <Btn href={routes.contact[lang]} variant="night" prefix="▶">{t('contactMe')}</Btn>
      </div>
    </div>

    <div class="flex flex-col gap-6 border-t-2 border-bordeaux pt-6 text-[17px] xl:flex-row xl:items-center xl:justify-between lg:text-[18px]">
      <nav aria-label={t('footer.sitemap')}>
        <ul class="m-0 grid list-none grid-cols-2 gap-x-7 gap-y-3 p-0 sm:flex" role="list">
          {channels.map((c) => (
            <li><a href={c.href} class="flex items-baseline gap-2 whitespace-nowrap no-underline hover:text-rose"><span class="font-vt text-[22px] text-rose">{pad2(c.n)}</span>{c.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-7">
        <a href={routes.legal[lang]} class="underline hover:text-rose">{t('footer.legal')}</a>
        <a href={routes.privacy[lang]} class="underline hover:text-rose">{t('footer.privacy')}</a>
        <a href={switchLang(Astro.url.pathname, other)} hreflang={other} lang={other} class="flex items-center gap-2 no-underline hover:text-rose" data-lang-switch>
          <span class="font-vt text-[22px] text-rose" aria-hidden="true">♪</span><span class="underline">{lang === 'fr' ? 'English version' : 'Version française'}</span>
        </a>
        <span class="text-rose">{t('footer.rights')}</span>
      </div>
    </div>
  </div>
</footer>
