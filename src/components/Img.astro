---
// Affiche une image de PocketBase, optimisée en WebP au moment du build,
// sans la déformer (la hauteur suit toujours les proportions d'origine).
import { Image } from 'astro:assets';
import type { Media } from '../lib/data';
import { fit } from '../lib/media';

interface Props {
  src: Media;
  alt?: string;
  class?: string;
  style?: string;
  /** largeur maximale générée (px) */
  width?: number;
  loading?: 'lazy' | 'eager';
}
const { src, alt = '', class: className, style, width = 1400, loading = 'lazy' } = Astro.props;
const size = await fit(src, width);
---
<Image src={src as any} alt={alt} width={size.width} height={size.height} format="webp" quality={82} loading={loading} decoding="async" class={className} style={style} />
