---
// ==========================================================
// ÉCRAN DE CHARGEMENT — « Réglage automatique »
// ----------------------------------------------------------
// Comme une vieille télé qu'on allume pour la première fois :
// l'écran s'allume depuis une ligne, le tuner balaie les
// fréquences et trouve les 4 chaînes du site au rythme du vrai
// chargement (polices, images). À 100 %, l'image décroche vers
// le haut et laisse place au site.
// • Une seule fois par visite (puis les pages s'enchaînent avec le zapping).
// • Bouton « Passer ▶ ». Désactivé si « réduire les animations ».
// Le fonctionnement est dans src/scripts/boot.ts.
// ==========================================================
import { channels, pad2 } from '../lib/channels';

// graduations du cadran : canaux UHF 21 → 69
const ticks = Array.from({ length: 49 }, (_, i) => 21 + i);
const bars = ['#D9D4CC', '#E2B84A', '#2EE6D6', '#8CBF6F', '#FF2E88', '#6F080C', '#4F86A6'];
---
<div id="boot" transition:persist="boot" role="status" aria-live="polite" aria-label="Chargement du site"
  class="boot fixed inset-0 z-[880] flex flex-col overflow-hidden bg-ink text-cream">
  <div class="boot-screen relative flex flex-1 flex-col px-5 pt-6 pb-5 sm:px-10 sm:pt-9 sm:pb-8">
    <!-- fond : marbre très léger + halo -->
    <div class="bg-marble pointer-events-none absolute inset-0 opacity-[.08] contrast-[1.4]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_45%,rgba(111,8,12,.45),transparent_70%)]" aria-hidden="true"></div>

    <!-- OSD du haut -->
    <div class="boot-glitch relative flex items-start justify-between gap-4 font-vt text-[20px] leading-none sm:text-[28px]">
      <span class="flex items-center gap-2.5 text-rose"><span class="animate-blink text-magenta" aria-hidden="true">●</span>MISE SOUS TENSION</span>
      <span class="text-right text-ch-green glow-green">AV · <span data-boot-freq>471.25</span> MHz</span>
    </div>

    <!-- centre -->
    <div class="boot-glitch relative mx-auto flex w-full max-w-[880px] flex-1 flex-col items-center justify-center gap-5 py-6 text-center sm:gap-7">
      <img src="/logo-bf.svg" alt="" width="256" height="96" class="h-14 w-auto sm:h-20" style="filter:drop-shadow(-3px 0 0 rgba(46,230,214,.7)) drop-shadow(3px 0 0 rgba(255,46,136,.7))" />
      <p class="m-0 font-display text-[clamp(1.9rem,6.2vw,4.25rem)] leading-[.9] chroma-3 sm:chroma-5">Réglage<br class="sm:hidden" /> automatique</p>

      <!-- pourcentage + barre à blocs -->
      <div class="flex w-full flex-col items-center gap-3">
        <span class="font-vt text-[clamp(4.5rem,15vw,8.5rem)] leading-[.8] text-ch-green [text-shadow:3px_3px_0_#000,-3px_0_#2EE6D6,3px_0_#FF2E88]"><span data-boot-pct>000</span>%</span>
        <div class="flex w-full max-w-[640px] gap-[3px] border-[3px] border-cream p-[3px] sm:gap-1 sm:p-1" aria-hidden="true">
          {Array.from({ length: 24 }, () => <span data-boot-seg class="h-4 flex-1 bg-cream/10 sm:h-5"></span>)}
        </div>
        <span class="font-vt text-[20px] leading-none text-rose sm:text-[24px]" data-boot-msg>Réglage de l'antenne…</span>
      </div>

      <!-- cadran du tuner -->
      <div class="relative w-full max-w-[720px] pt-1" aria-hidden="true">
        <div class="flex h-9 items-end justify-between border-b-2 border-cream/60 px-1">
          {ticks.map((t) => <span class:list={['w-px bg-cream/60', t % 8 === 5 ? 'h-full bg-cream' : t % 2 ? 'h-1/2' : 'h-1/3']}></span>)}
        </div>
        <div class="mt-1.5 flex justify-between px-1 font-vt text-[16px] leading-none text-cream/70 sm:text-[18px]">
          {ticks.filter((t) => t % 8 === 5).map((t) => <span>{t}</span>)}
        </div>
        <span data-boot-needle class="absolute top-0 left-0 h-11 w-[3px] -translate-x-1/2 bg-magenta shadow-[0_0_10px_#FF2E88]"></span>
        <span class="absolute -top-0.5 left-0 font-vt text-[14px] leading-none text-cream/60 sm:text-[16px]">UHF</span>
      </div>

      <!-- chaînes trouvées -->
      <ul class="m-0 grid w-full max-w-[720px] list-none grid-cols-1 gap-x-8 gap-y-2 p-0 font-vt text-[20px] leading-none sm:grid-cols-2 sm:text-[24px]" role="list">
        {channels.map((c) => (
          <li data-boot-ch class="flex items-baseline gap-2 text-cream/40 transition-colors duration-300">
            <span class="text-ch-green">CH {pad2(c.n)}</span>
            <span class="text-left">{c.label.toUpperCase()}</span>
            <span class="flex-1 overflow-hidden whitespace-nowrap text-cream/25" aria-hidden="true">··························</span>
            <span data-boot-state class="whitespace-nowrap">RECHERCHE</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- bas : mire + passer -->
    <div class="relative flex items-end justify-between gap-4">
      <div class="grid h-3 w-[min(420px,55vw)] grid-cols-7 sm:h-4" aria-hidden="true">
        {bars.map((c) => <span data-boot-bar class="opacity-15 transition-opacity duration-300" style={`background:${c}`}></span>)}
      </div>
      <button type="button" data-boot-skip
        class="btn-retro border-[3px] border-cream bg-transparent px-4 py-1.5 font-vt text-[22px] font-normal leading-none text-cream [--sh:#000] [--sh-x:4px] [--sh-y:4px] hover:bg-bordeaux sm:text-[26px]">
        Passer ▶
      </button>
    </div>

    <!-- neige du décrochage final -->
    <canvas data-boot-noise width="240" height="135" class="pointer-events-none absolute inset-0 size-full opacity-0 [image-rendering:pixelated]" aria-hidden="true"></canvas>
  </div>
</div>
<!-- Déjà vu pendant cette visite (ou animations réduites) : on le masque avant
     même l'affichage, sinon on bloque le défilement et on met l'intro en pause. -->
<script is:inline>
  (function () {
    var boot = document.getElementById('boot');
    if (!boot || boot.dataset.done) return;
    var seen = false;
    try { seen = sessionStorage.getItem('canalbf-boot') === '1'; } catch (e) {}
    if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) { boot.hidden = true; boot.dataset.done = '1'; }
    else document.documentElement.classList.add('booting');
  })();
</script>
<noscript><style>#boot { display: none !important; }</style></noscript>
